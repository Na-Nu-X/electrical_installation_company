# Copy to backend/.env and adjust for your environment.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty for SQLite. Production example:
# DATABASE_URL=postgres://elektro:password@localhost:5432/elektro
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=
QUOTE_THROTTLE_RATE=20/hour
